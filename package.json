{
  "name": "@wthek/mcp",
  "version": "1.0.0",
  "mcpName": "io.github.Skillnter/wthek-mcp",
  "description": "Model Context Protocol (MCP) server for @wthek and http-error-kit. Provides AI coding agents with tools to audit error handling, look up HTTP standards, and retrieve verified framework recipes.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "wthek-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "jest --config jest.config.ts",
    "build": "tsc --build",
    "coverage": "jest --coverage --config jest.config.ts",
    "lint": "eslint src/",
    "prepublishOnly": "npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Skillnter/wthek-mcp.git"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agent",
    "agent-skill",
    "claude",
    "cursor",
    "copilot",
    "antigravity",
    "rfc-7807",
    "rfc-9457",
    "structured-errors",
    "api-error-response",
    "error-handling",
    "http-error-kit",
    "wthek",
    "skillnter",
    "code-audit",
    "http-status-codes"
  ],
  "author": "Himanshu Bansal <skillhimanshubansal@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Skillnter/wthek-mcp/issues"
  },
  "homepage": "https://github.com/Skillnter/wthek-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "http-error-kit": "^1.5.0",
    "http-response-status-code": "^1.9.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "eslint": "^8.57.1",
    "eslint-plugin-security": "^3.0.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3"
  },
  "publishConfig": {
    "@skillnter:registry": "https://npm.pkg.github.com/"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "llms.txt",
    "LICENSE"
  ],
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/Skillnter"
    },
    {
      "type": "patreon",
      "url": "https://www.patreon.com/skillnter"
    },
    {
      "type": "open_collective",
      "url": "https://opencollective.com/skillnter"
    },
    {
      "type": "buy_me_a_coffee",
      "url": "https://buymeacoffee.com/skillnter"
    },
    {
      "type": "paypal",
      "url": "https://www.paypal.com/paypalme/skillnter"
    }
  ]
}